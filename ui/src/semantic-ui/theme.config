/*******************************
        Theme Selection
*******************************/

/* To override a theme for an individual element
   specify theme name below
*/

/* Global */
@site        : 'material';
@reset       : 'material';

/* Elements */
@button      : 'material';
@container   : 'material';
@divider     : 'material';
@flag        : 'default';
@header      : 'material';
@icon        : 'default';
@image       : 'material';
@input       : 'material';
@label       : 'material';
@list        : 'material';
@loader      : 'material';
@placeholder : 'material';
@rail        : 'material';
@reveal      : 'material';
@segment     : 'material';
@step        : 'material';

/* Collections */
@breadcrumb  : 'material';
@form        : 'material';
@grid        : 'material';
@menu        : 'material';
@message     : 'material';
@table       : 'material';

/* Modules */
@accordion   : 'material';
@checkbox    : 'default';
@dimmer      : 'material';
@dropdown    : 'material';
@embed       : 'material';
@modal       : 'material';
@nag         : 'material';
@popup       : 'material';
@progress    : 'material';
@rating      : 'material';
@search      : 'material';
@shape       : 'material';
@sidebar     : 'material';
@sticky      : 'material';
@tab         : 'material';
@transition  : 'material';

/* Views */
@ad          : 'material';
@card        : 'material';
@comment     : 'material';
@feed        : 'material';
@item        : 'material';
@statistic   : 'material';

/*******************************
            Folders
*******************************/

@themesFolder : 'themes';
@siteFolder  : '../../src/semantic-ui/site';

/*******************************
         Import Theme
*******************************/

@import (multiple) '~semantic-ui-less/theme.less';
@fontPath : '../../../themes/@{theme}/assets/fonts';

/* End Config */
